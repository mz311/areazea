# ─────────────────────────────────────────────────────────────────────────────
#  FiveM Base Manager — configuration (copier en `.env` puis adapter)
#  Ne commitez JAMAIS le fichier .env. Aucune de ces valeurs n'est exposée au navigateur.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique du site (https en production). Sert aux redirections OAuth, aux liens et au contrôle d'origine (CSRF).
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://fbm:fbm@localhost:5432/fbm

# Secret aléatoire >= 32 caractères (signe les liens de téléchargement locaux et l'état OAuth).
#   openssl rand -base64 48
APP_SECRET=changez-moi-par-une-longue-valeur-aleatoire-de-48-caracteres

# ── Discord OAuth2 (https://discord.com/developers/applications) ─────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID du serveur Discord de votre communauté (mode développeur → clic droit sur le serveur → Copier l'identifiant)
DISCORD_GUILD_ID=
# Optionnel : jeton du bot (rafraîchit rôles et appartenance toutes les 10 min sans reconnexion)
DISCORD_BOT_TOKEN=
# Lien d'invitation affiché sur le site (modifiable aussi dans Admin → Paramètres)
DISCORD_INVITE_URL=

# ── Correspondance rôles Discord → permissions (IDs séparés par des virgules) ─
# Le plus haut rôle gagne. Si DISCORD_ROLE_MEMBER_IDS est renseigné, il est exigé pour télécharger.
DISCORD_ROLE_MEMBER_IDS=
DISCORD_ROLE_VIP_IDS=
DISCORD_ROLE_DEVELOPER_IDS=
DISCORD_ROLE_ADMIN_IDS=
# Comptes Discord toujours administrateurs (amorçage du premier admin) — IDs utilisateur
ADMIN_DISCORD_IDS=

# ── Webhooks Discord (Paramètres du salon → Intégrations → Webhooks) ─────────
# Annonces publiques de mises à jour / annonces
DISCORD_WEBHOOK_URL=
# Notifications de maintenance (sinon : DISCORD_WEBHOOK_URL)
DISCORD_MAINTENANCE_WEBHOOK_URL=
# Salon staff : versions réservées VIP / développeurs / bêta (jamais annoncées dans le salon public)
DISCORD_PRIVATE_WEBHOOK_URL=
# Rôle mentionné pour les mises à jour publiques et nouvelles ressources (seul ce rôle peut être ping)
DISCORD_NOTIFY_ROLE_ID=

# ── Stockage privé des fichiers ───────────────────────────────────────────────
# local = dossier sur le serveur ; s3 = AWS S3, Cloudflare R2, MinIO, Backblaze B2, Scaleway…
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data

# Si STORAGE_DRIVER=s3 :
S3_ENDPOINT=
# Endpoint joignable depuis Internet pour les liens présignés (si S3_ENDPOINT est un nom interne, ex. http://minio:9000)
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true pour MinIO et la plupart des S3 « maison »
S3_FORCE_PATH_STYLE=false

# ── Limites & sécurité des téléchargements / uploads ─────────────────────────
# Durée de validité des liens de téléchargement (secondes, 30–3600)
DOWNLOAD_URL_TTL_SECONDS=300
# Taille maximale de l'archive ZIP uploadée (Mo)
MAX_UPLOAD_MB=2048
# Limites anti « zip bomb » appliquées à l'archive
MAX_ARCHIVE_FILES=50000
MAX_FILE_MB=512
MAX_UNCOMPRESSED_MB=8192
MAX_COMPRESSION_RATIO=200
# Extensions refusées dans les archives (exécutables / scripts Windows)
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.com,.scr,.msi,.ps1,.vbs,.vbe,.lnk,.jar,.sh

# URL de téléchargement du launcher affichée sur le site (modifiable dans Admin → Paramètres)
LAUNCHER_DOWNLOAD_URL=
