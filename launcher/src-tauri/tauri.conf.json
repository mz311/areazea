{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FiveM Base Launcher",
  "version": "1.0.0",
  "identifier": "com.fivembase.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FiveM Base Launcher",
        "width": 1000,
        "height": 660,
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "backgroundColor": "#050509"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"]
      }
    }
  }
}
